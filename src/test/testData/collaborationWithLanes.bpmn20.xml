<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://flowable.org/processdef">
  <collaboration id="collab">
    <participant id="pool1" name="Sales" processRef="salesProcess"/>
  </collaboration>
  <process id="salesProcess" name="Sales" isExecutable="true">
    <laneSet id="laneSet1">
      <lane id="lane1" name="Rep">
        <flowNodeRef>start</flowNodeRef>
      </lane>
      <lane id="lane2" name="Manager"/>
    </laneSet>
    <startEvent id="start" name="Begin"/>
    <sequenceFlow id="f1" sourceRef="start" targetRef="end"/>
    <endEvent id="end"/>
  </process>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="collab">
      <bpmndi:BPMNShape id="s_pool" bpmnElement="pool1" isHorizontal="true">
        <omgdc:Bounds x="100" y="100" width="600" height="250"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_lane1" bpmnElement="lane1" isHorizontal="true">
        <omgdc:Bounds x="130" y="100" width="570" height="125"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_lane2" bpmnElement="lane2" isHorizontal="true">
        <omgdc:Bounds x="130" y="225" width="570" height="125"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_start" bpmnElement="start">
        <omgdc:Bounds x="180" y="145" width="30" height="30"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_end" bpmnElement="end">
        <omgdc:Bounds x="600" y="145" width="30" height="30"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="e_f1" bpmnElement="f1">
        <omgdi:waypoint x="210" y="160"/>
        <omgdi:waypoint x="600" y="160"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
