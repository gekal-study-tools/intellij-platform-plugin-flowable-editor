<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://flowable.org/processdef">
  <process id="orderProcess" name="Order" isExecutable="true">
    <startEvent id="start" name="Order received"/>
    <sequenceFlow id="flow1" sourceRef="start" targetRef="approve"/>
    <userTask id="approve" name="Approve order" flowable:candidateGroups="managers"/>
    <sequenceFlow id="flow2" sourceRef="approve" targetRef="decision"/>
    <exclusiveGateway id="decision" name="Approved?" default="flow4"/>
    <sequenceFlow id="flow3" sourceRef="decision" targetRef="ship">
      <conditionExpression xsi:type="tFormalExpression"
                           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${approved}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow4" sourceRef="decision" targetRef="end"/>
    <serviceTask id="ship" name="Ship" flowable:class="com.example.ShipDelegate"/>
    <sequenceFlow id="flow5" sourceRef="ship" targetRef="end"/>
    <endEvent id="end" name="Done"/>
  </process>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="orderProcess">
      <bpmndi:BPMNShape id="s1" bpmnElement="start">
        <omgdc:Bounds x="100" y="100" width="30" height="30"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s2" bpmnElement="approve">
        <omgdc:Bounds x="180" y="75" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s3" bpmnElement="decision">
        <omgdc:Bounds x="330" y="90" width="40" height="40"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s4" bpmnElement="ship">
        <omgdc:Bounds x="420" y="75" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s5" bpmnElement="end">
        <omgdc:Bounds x="570" y="100" width="30" height="30"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="e1" bpmnElement="flow1">
        <omgdi:waypoint x="130" y="115"/>
        <omgdi:waypoint x="180" y="115"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
