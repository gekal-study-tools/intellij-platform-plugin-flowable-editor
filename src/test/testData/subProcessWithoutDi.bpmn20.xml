<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://flowable.org/processdef">
  <process id="reviewProcess" name="Review" isExecutable="true">
    <startEvent id="start"/>
    <sequenceFlow id="f1" sourceRef="start" targetRef="review"/>
    <subProcess id="review" name="Review">
      <startEvent id="innerStart"/>
      <sequenceFlow id="if1" sourceRef="innerStart" targetRef="innerTask"/>
      <userTask id="innerTask" name="Check" flowable:assignee="kermit"/>
      <sequenceFlow id="if2" sourceRef="innerTask" targetRef="innerEnd"/>
      <endEvent id="innerEnd"/>
    </subProcess>
    <boundaryEvent id="timeout" attachedToRef="review" cancelActivity="true">
      <timerEventDefinition>
        <timeDuration>PT1H</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>
    <sequenceFlow id="f2" sourceRef="review" targetRef="end"/>
    <sequenceFlow id="f3" sourceRef="timeout" targetRef="end"/>
    <endEvent id="end"/>
  </process>
</definitions>
